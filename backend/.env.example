# Copy to .env and fill in. All values are optional except the API key for real AI.

# ---- LLM (OpenAI-compatible) ----
# groq | openai | openai_compatible | mock   (mock = offline fake LLM, no key needed)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.6-27b
LLM_REASONING_EFFORT=low
# For non-Groq providers, set LLM_API_KEY (takes precedence over GROQ_API_KEY), e.g.
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Retry / rate-limit handling (429/5xx -> exponential backoff, honours Retry-After)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=30
LLM_MAX_CONCURRENCY=4

# ---- App ----
# development | staging | production
ENVIRONMENT=development
# DATABASE_URL=sqlite:///./gd_arena.db
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ---- Testing / Simulation ----
# Simulate Groq LLM quota exhaustion without hitting the real API limit.
# Values:
#   off       (default) normal behaviour
#   exhausted forces llm_status=exhausted with retry_at 5 minutes ahead
#   recover   forces llm_status=exhausted, then automatically recovers after 60 seconds
# Ignored when ENVIRONMENT=production unless ALLOW_SIMULATE_IN_PRODUCTION=true.
SIMULATE_LLM_EXHAUSTED=off
ALLOW_SIMULATE_IN_PRODUCTION=false

# ---- GD behaviour ----
# Simulated AI speaking time in words/minute (150 WPM ~= 2.5 words/sec; 0 = instant release)
AI_SPEAKING_WPM=150
AI_GENERATION_TIMEOUT_SECONDS=45
AI_HAND_RAISE_MULTIPLIER=1.0
AI_IDLE_NUDGE_SECONDS=2.5
AI_MAX_QUEUED=2
DEFAULT_TURN_LIMIT_SECONDS=60
# Natural pause between consecutive AI speakers (seconds)
TURN_GAP_SECONDS=1.0
AUDIO_END_BUFFER_SECONDS=0.2
# Humans who raise a hand are queued ahead of waiting AIs
HUMAN_QUEUE_PRIORITY=true
MAX_HUMAN_TURN_CHARS=2000

# ---- Voice ----
# whisper (Groq Whisper) | faster_whisper (local stub) | text (disabled) | mock
STT_PROVIDER=whisper
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_MODEL=whisper-large-v3
# groq (Groq Orpheus WAV + auto Edge fallback) | edge (Edge TTS MP3) | none | mock
TTS_PROVIDER=groq
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Accent preference: "neutral" (default Orpheus voices) | "indian" (Edge en-IN voices: Neerja, Neerja Expressive, Prabhat)
TTS_ACCENT_PREFERENCE=neutral
TTS_TIMEOUT_SECONDS=20.0
TTS_COOLDOWN_SECONDS=60.0
# Optional per-persona voice overrides (JSON dict or comma-separated key=voice pairs)
# TTS_VOICE_MAP=aggressive_debater=troy,calm_analyst=diana
