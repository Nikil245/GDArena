# Backend REST API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket base URL (no trailing slash; /ws/{code} is appended automatically)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Development-only cold-start simulator (ignored in production builds).
# Uncomment or set to 1 when running `npm run dev` to delay the initial /health
# ping and first API request by ~20 seconds (with simulated 503 responses) so
# you can test the waking-up banner and modal locally.
# NEXT_PUBLIC_SIMULATE_COLD_START=1

